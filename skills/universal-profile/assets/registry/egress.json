      "purpose": "Envio GraphQL indexer for LUKSO profiles and assets.",
      "when": "token list / asset discovery on LUKSO",
      "hosts": [
        "envio.lukso-mainnet.universal.tech",
        "envio.lukso-testnet.universal.tech"
      ]
    },
    "profileMetadata": {
      "purpose": "Profile metadata (LSP3): IPFS uploads of profile images and the metadata JSON (Universal Profile IPFS API by default; Pinata when chosen), the IPFS gateway used to read and verify IPFS content (also token metadata), and profile.link to resolve the profile URL. Maintained by hand (not generated from the registry). A Kubo node you configure is not listed.",
      "when": "profile metadata show/set, profile url, profile join (metadata check), token metadata --fetch-json",
      "hosts": [
        "api.pinata.cloud",
        "api.universalprofile.cloud",
        "profile.link",
        "t.profile.link"
      ]
    },
    "protocolApis": {
      "purpose": "Optional third-party APIs the agent may call for quotes or orders (knowledge in references/protocols.md; the skill has no per-protocol code).",
      "when": "only when the user asks for a swap/bridge quote through that service",
      "hosts": [
        "api.cow.fi",
        "trade-api.gateway.uniswap.org",
        "app.across.to",
        "li.quest"
      ]
    },
    "runtime": {
      "purpose": "User-space Node.js download, only when Node >= 22 is missing and the human agreed to install it.",
      "when": "installation only",
      "hosts": [
        "nodejs.org"
      ]
    },
    "prices": {
      "purpose": "Native-coin prices in USD for funding suggestions (about $1 / $10 worth); optional, cached 10 minutes; without it the skill suggests coin amounts only.",
      "when": "funding suggest",
      "hosts": [
        "api.coingecko.com"
      ]
    }
