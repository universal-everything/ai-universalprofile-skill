{
  "name": "@universal-everything/universal-profile-skill",
  "version": "0.1.0",
  "private": true,
  "description": "Universal Profile Agent Skill: gives any AI agent its own LUKSO Universal Profile (ERC725 account + LSP6 Key Manager) on any EVM chain. Source of the bundled skill in skills/universal-profile.",
  "license": "MIT-0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/universal-everything/ai-universalprofile-mcp"
  },
  "homepage": "https://universalprofile.ai",
  "scripts": {
    "build": "node build/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:chain": "vitest run test/chain",
    "gen:registry": "node build/gen-registry.mjs",
    "gen:abis": "node build/gen-abis.mjs",
    "verify:skill": "node build/verify-skill.mjs"
  },
  "dependencies": {
    "@erc725/erc725.js": "0.28.2",
    "@modelcontextprotocol/sdk": "1.32.1",
    "qrcode": "1.5.4",
    "viem": "2.57.4"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/qrcode": "1.5.6",
    "esbuild": "0.28.2",
    "hardhat": "3.19.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
